[Unit]
Description=Local MTProto proxy server for partial bypassing of Telegram ban (rust port)
After=network.target

[Container]
Image=docker.io/valnesfjord/tg-ws-proxy-rs
Label="tg-ws-proxy"
AutoUpdate=registry
PublishPort=1443:1443
Exec=--secret "REPLACE_WITH_HOST_SECRET" --host 0.0.0.0

[Install]
WantedBy=default.target